        .info {
            margin-top: 20px;
            padding: 15px;
            background: #e7f3ff;
            border-left: 4px solid #2196F3;
            border-radius: 5px;
        }
        .info h3 {
            color: #2196F3;
            margin-bottom: 10px;
        }
        .info p {
            color: #555;
            line-height: 1.6;
        }
        .back-link {
            text-align: center;
            margin-top: 20px;
        }
        .back-link a {
            color: #764ba2;
            text-decoration: none;
            font-weight: 600;
        }
        .back-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="calculator">
        <h1>🧮 Kalkulator TSK9</h1>
        <p style="text-align:center; color:#666; margin-bottom:20px;">
            Digital Root dari Kuadrat Angka
        </p>
        
        <div class="input-group">
            <label for="number">Masukkan Angka:</label>
            <input type="number" id="number" placeholder="Contoh: 7" min="1">
        </div>
        
        <button onclick="calculate()">Hitung Digital Root</button>
        
        <div id="result" class="result">
            <div class="result-item">
                <span class="result-label">Angka Input:</span>
                <span class="result-value" id="inputValue">-</span>
            </div>
            <div class="result-item">
                <span class="result-label">Kuadrat:</span>
                <span class="result-value" id="squareValue">-</span>
            </div>
            <div class="result-item">
                <span class="result-label">Digital Root:</span>
                <span class="result-value" id="digitalRoot">-</span>
            </div>
            <div class="result-item">
                <span class="result-label">Proses:</span>
                <span class="result-value" id="process" style="font-size:14px;">-</span>
            </div>
        </div>
        
        <div class="info">
            <h3>ℹ️ Cara Kerja:</h3>
            <p>
                1. Masukkan angka → dikuadratkan<br>
                2. Hasil kuadrat → dijumlahkan digit-digitnya<br>
                3. Jika hasil > 9, ulangi penjumlahan<br>
                4. Hasil akhir = Digital Root (1-9)
            </p>
        </div>
        
        <div class="back-link">
            <a href="index.html">← Kembali ke Menu Utama</a>
        </div>
    </div>
    
    <script>
        function digitalRoot(n) {
            if (n === 0) return 0;
            return 1 + ((n - 1) % 9);
        }
        
        function showProcess(n) {
            let process = [];
            let current = n;
            
            while (current > 9) {
                let digits = current.toString().split('').map(Number);
                let sum = digits.reduce((a, b) => a + b, 0);
                process.push(`${digits.join('+')} = ${sum}`);
                current = sum;
            }
            
            return process.length > 0 ? process.join(' → ') : `${n} (single digit)`;
        }
        
        function calculate() {
            const input = document.getElementById('number').value;
            
            if (!input || input < 1) {
                alert('Masukkan angka positif!');
                return;
            }
            
            const num = parseInt(input);
            const square = num * num;
            const dr = digitalRoot(square);
            const process = showProcess(square);
            
            document.getElementById('inputValue').textContent = num;
            document.getElementById('squareValue').textContent = `${num}² = ${square}`;
            document.getElementById('digitalRoot').textContent = dr;
            document.getElementById('process').textContent = process;
            
            const resultDiv = document.getElementById('result');
            resultDiv.classList.add('show');
        }
        
        // Enter key support
        document.getElementById('number').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                calculate();
            }
        });
    </script>
</body>
</html>
